# APEX Weather v2 — copy to an untracked .env or /etc/apex-weather/apex-weather.env
TRADING_MODE=paper
BANKROLL=100
DATABASE_PATH=/var/lib/apex-weather/apex_weather.sqlite3
KALSHI_BASE_URL=https://external-api.kalshi.com/trade-api/v2
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=/etc/apex-weather/kalshi_private.pem
LIVE_ENABLEMENT_PATH=/var/lib/apex-weather/LIVE_ENABLED

MIN_NET_EDGE=0.05
MIN_MODEL_CONFIDENCE=0.70
MAX_SPREAD_CENTS=8
MIN_LIQUIDITY=10
MAX_FORECAST_DISAGREEMENT_F=10
MONTE_CARLO_SIMULATIONS=10000

JEV_ENABLED=false
JEV_API_KEY=
JEV_ENDPOINT=https://jevtypesafeai.com/api/v1/decide
JEV_MODEL=jev-latest
JEV_MIN_CONFIDENCE=0.75
JEV_OBVIOUS_EDGE=0.15
RUNTIME_LLM_ENABLED=false
OPENAI_API_KEY=
RUNTIME_LLM_MODEL=gpt-6-luna
LLM_REVIEW_DISAGREEMENT_F=7
MAX_AI_DAILY_USD=0.10
MAX_AI_MONTHLY_USD=1.00

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_DAILY_SUMMARY_UTC=23:55
NWS_USER_AGENT=APEX-Weather/2.0 contact=your-email@example.com
MONTHLY_VPS_COST_USD=21.09

# Independent live store and conservative hard limits; never enable automatically.
LIVE_DATABASE_PATH=/var/lib/apex-weather/apex_live.sqlite3
LIVE_MAX_ORDER_USD=2
LIVE_MAX_EXPOSURE_USD=10
LIVE_MAX_CITY_EXPOSURE_USD=5
LIVE_MAX_DAILY_LOSS_USD=2
LIVE_MAX_DRAWDOWN=0.10
LIVE_MAX_OPEN_POSITIONS=3
LIVE_MAX_DAILY_ORDERS=10
LIVE_BALANCE_FLOOR_USD=20
# Set these to verified prices for TELEGRAM_CHAT_MODEL to enable AI topic routing.
# Status commands and alerts work without AI or these settings.
TELEGRAM_INPUT_USD_PER_MILLION=0
TELEGRAM_OUTPUT_USD_PER_MILLION=0
